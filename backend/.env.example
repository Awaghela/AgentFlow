# --- Core ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- CORS ---
# Comma-separated list of allowed origins. In production this should be your
# deployed frontend's URL(s), e.g.:
#   CORS_ORIGINS=https://agentflow.vercel.app,https://agentflow-git-main-team.vercel.app
# Vercel preview subdomains (*.vercel.app) are already allowed via a regex in
# app/main.py, so you mainly need your production domain here.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
# Used as-is by docker-compose; override for local (non-docker) runs.
# Railway/Heroku-style "postgres://" or "postgresql://" URLs are normalized
# to "postgresql+psycopg://" automatically — paste Railway's DATABASE_URL
# reference variable in unmodified.
DATABASE_URL=postgresql+psycopg://agentflow:agentflow@localhost:5432/agentflow

# --- LLM ---
# Leave ANTHROPIC_API_KEY unset (and LLM_MODE=simulation) to run AgentFlow
# fully offline with deterministic, reproducible planning/response output —
# this is what the 120-scenario eval suite runs against.
#
# Set both to switch the plan/respond nodes over to live Claude calls.
LLM_MODE=simulation
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Retrieval / embedding backend ---
# "auto" (default) — use Cohere automatically if COHERE_API_KEY is set
# below, otherwise fall back to tfidf. Just filling in the key is enough —
# no separate flag to flip. Override explicitly if you want to force a
# specific backend regardless of whether a key is present:
#
# "tfidf" — in-memory TF-IDF + cosine similarity. Zero external
# dependencies, zero DB round-trips, fully deterministic. The 120-scenario
# eval suite always runs against this (and with reranking off) regardless
# of what's configured here — see app/eval/runner.py's
# force_eval_offline_mode() — so results stay reproducible and re-seeding
# never spends live API quota.
#
# "local" — real dense embeddings via a local sentence-transformers model,
# stored and queried through pgvector. Needs:
#   pip install -r requirements-local-embeddings.txt --break-system-packages
# then: python -m scripts.ingest_documents
#
# "cohere" — real dense embeddings via Cohere's Embed API, stored and
# queried through pgvector. Needs COHERE_API_KEY, then:
#   python -m scripts.ingest_documents
EMBEDDING_BACKEND=auto

# Which corpus to embed/search over:
#   "seed"       (default) — the original 12 fictional demo policy docs
#   "real_world" — 14 documents grounded in real, current, public-domain
#                  U.S. federal regulatory guidance (FTC refund/negative-
#                  option rules, data breach response, HIPAA/Health Breach
#                  Notification Rule, the FTC Safeguards Rule), spanning
#                  billing/security/healthcare/finance
#   "combined"   — both
CORPUS_SOURCE=seed

COHERE_API_KEY=
COHERE_EMBED_MODEL=embed-v4.0
COHERE_EMBED_DIMENSION=1024

LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOCAL_EMBEDDING_DIMENSION=384

# --- Reranking (optional second-stage relevance refinement) ---
# "auto" (default) — use Cohere Rerank automatically if COHERE_API_KEY is
# set, otherwise skip reranking. Same auto-detection as EMBEDDING_BACKEND.
# Works with ANY embedding backend (including tfidf) — reranking only
# needs the candidates' text, not whatever produced them. Set explicitly
# to override: "none" forces no reranking even with a key present,
# "cohere" forces it on (redundant with "auto" once a key is set).
RERANK_PROVIDER=auto
COHERE_RERANK_MODEL=rerank-v3.5
RERANK_CANDIDATE_POOL=10

# --- Orchestration tuning ---
MAX_PLAN_STEPS=6
TOOL_CALL_TIMEOUT_S=8.0
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.18
AUTO_APPROVE_CONFIDENCE=0.82
FALLBACK_MAX_RETRIES=2

# --- Eval harness ---
EVAL_SCENARIO_COUNT=120
EVAL_SEED=42
