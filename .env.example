# Copy this to `.env` in this same directory (repo root) — docker compose
# loads it automatically, no extra flags needed. Everything below is
# optional; leave it all blank/default to run fully offline with zero API
# keys, which is what `docker compose up --build` does out of the box.

# --- Cohere ---
# Just fill this in — that's it. EMBEDDING_BACKEND and RERANK_PROVIDER
# both default to "auto" below, which means the moment this key is set,
# retrieval and reranking both switch over to real Cohere calls
# automatically. No other flag to remember.
#
# The 120-scenario eval suite is the one exception: it always runs against
# tfidf with no reranking, regardless of this key, so results stay
# reproducible and re-seeding your dev database never spends live API
# quota. Everything else (the running app, demo data seeding) does use
# your key once it's set here.
COHERE_API_KEY=

# "auto" (default) — Cohere if COHERE_API_KEY is set above, else tfidf /
# no reranking. Set explicitly to override auto-detection either way:
#   EMBEDDING_BACKEND=tfidf    # force offline even with a key present
#   EMBEDDING_BACKEND=local    # force the local sentence-transformers model
#   EMBEDDING_BACKEND=cohere   # force Cohere (same as auto, with a key set)
#   RERANK_PROVIDER=none       # force no reranking even with a key present
EMBEDDING_BACKEND=auto
RERANK_PROVIDER=auto
CORPUS_SOURCE=seed

# --- Anthropic: live plan/response text instead of deterministic simulation ---
# Unrelated to Cohere/retrieval — this only affects the LangGraph plan and
# respond nodes. Leave blank to keep LLM_MODE=simulation (what the eval
# suite runs against).
LLM_MODE=simulation
ANTHROPIC_API_KEY=
