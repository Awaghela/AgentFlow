# Base URL of the FastAPI backend's v1 API.
#
# Local dev (default):
VITE_API_BASE_URL=http://localhost:8000/api/v1
#
# Production (Vercel): set this in the Vercel project's Environment Variables
# to your deployed Railway backend, e.g.:
#   VITE_API_BASE_URL=https://agentflow-backend-production.up.railway.app/api/v1
# Vite bakes env vars in at build time — changing this requires a redeploy,
# not just a restart.
